# Modelo sem segredos. Copie para .env e preencha aí.
# O .env não vai para o GitHub.
#
# Troque a senha do banco no Supabase antes de colar:
# Project Settings > Database > Reset password.
# Se a senha tiver caractere especial, codifique na URL:
#   #  -> %23
#   @  -> %40
#   %  -> %25
#   /  -> %2F
#   ?  -> %3F
#   &  -> %26
#
# DATABASE_URL: Supabase > Connect > Session pooler (porta 5432).
# Não use o endereço direto (db....supabase.co): o Render não alcança IPv6.
# Não use a porta 6543 (Transaction pooler).

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
BREVO_API_KEY=
EMAIL_REMETENTE=
NOME_REMETENTE=
SECRET_KEY=
URL_PUBLICA=
