# Modelo sem segredos. Copie para .env e preencha aí.
# O .env não vai para o GitHub.
#
# Troque a senha do banco no Supabase antes de colar:
# Project Settings > Database > Reset password.
# Se a senha tiver caractere especial, codifique na URL:
#   #  -> %23
#   @  -> %40
#   %  -> %25
#   /  -> %2F
#   ?  -> %3F
#   &  -> %26
#
# DATABASE_URL: Supabase > Connect > Session pooler (porta 5432).
# Não use o endereço direto (db....supabase.co): o Render não alcança IPv6.
# Não use a porta 6543 (Transaction pooler).

# No painel do Supabase, SUPABASE_PUBLISHABLE_KEY corresponde a SUPABASE_ANON_KEY.
# SUPABASE_SECRET_KEY corresponde a SUPABASE_SERVICE_KEY.
# O site é Python. Não instale @supabase/server.

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWKS_URL=
BREVO_API_KEY=
EMAIL_REMETENTE=
NOME_REMETENTE=
SECRET_KEY=
URL_PUBLICA=

# Acesso inicial do painel. Se ficarem vazios, flask criar-super-admin
# usa o e-mail e a senha documentados em README_ATUALIZACOES.md.
# Preencha ADMIN_SENHA para trocar a senha do master ao rodar o comando de novo.
ADMIN_EMAIL=
ADMIN_SENHA=

# Opcional. Disparo futuro pela API oficial da Meta (WhatsApp Business).
# Enquanto estiverem vazias, o painel não envia nada para a Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
